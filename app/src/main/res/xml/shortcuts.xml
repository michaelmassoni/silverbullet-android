<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:shortcutId="capture"
        android:shortcutShortLabel="@string/capture_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.michaelmassoni.silverbullet.CaptureActivity"
            android:targetPackage="io.github.michaelmassoni.silverbullet" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/settings_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.michaelmassoni.silverbullet.SettingsActivity"
            android:targetPackage="io.github.michaelmassoni.silverbullet" />
    </shortcut>
</shortcuts>
